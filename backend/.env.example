# Copy to .env and fill in your values

# Anthropic (required — powers NL parsing)
ANTHROPIC_API_KEY=sk-ant-...

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=workflow-builder

# Slack (optional — required for slack.send_message tool)
SLACK_BOT_TOKEN=xoxb-...

# SendGrid (optional — required for email.send tool)
SENDGRID_API_KEY=SG...
FROM_EMAIL=noreply@yourcompany.com

# Jira (optional — required for jira.create_ticket tool)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=...
