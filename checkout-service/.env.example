# Datadog — logs will be shipped to this account
DATADOG_API_KEY=your_dd_api_key_here
DATADOG_SITE=datadoghq.com

# Orq webhook URL — fired directly when a scenario is triggered
# Format: https://orq-runtime-production.up.railway.app/api/v1/webhooks/datadog/tpl-incident-response
ORQ_WEBHOOK_URL=https://your-orq-runtime.up.railway.app/api/v1/webhooks/datadog/tpl-incident-response
